# Copy to backend/.env and fill in real values. Never commit the real .env
# (already gitignored at the repo root). See backend/app/core/settings.py
# for what each of these actually controls.

# ── Database ──────────────────────────────────────────────────────────────
# Matches docker-compose.yml + db-init/01-app-role.sql out of the box —
# only change these if you're pointing at something other than the local
# docker-compose Postgres (e.g. the Neon free tier from the deployment map).
DATABASE_URL=postgresql+asyncpg://platform_app:platform_app_dev_only@localhost:15432/platform
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://platform:platform_dev_only@localhost:15432/platform

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEFAULT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM providers (Phase 4) ─────────────────────────────────────────────
# Leave both blank to keep running on the zero-config "mock" provider.
# Fill in ONE of these to select "gemini" or "groq" as a tenant's llm_provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
