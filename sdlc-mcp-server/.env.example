# ─────────────────────────────────────────────────────────────────────
#  sdlc-mcp-server/.env.example — copy to .env and fill in real values.
#  OAuth 2.1 auth (MCP 2025 standard).
#  External hosts (Claude Desktop, Cursor, Antigravity) use browser OAuth flow.
#  Internal service (ai-sdlc-assistant) uses OAUTH_SERVICE_TOKEN directly.
# ─────────────────────────────────────────────────────────────────────

# ── MCP Server ────────────────────────────────────────────────────────
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8100

# ── OAuth 2.1 ─────────────────────────────────────────────────────────
# Public URL that clients reach this server at (must match what hosts see)
OAUTH_ISSUER_URL=http://127.0.0.1:8100
# Optional PIN shown on the browser consent page — empty = no PIN
OAUTH_CONSENT_PIN=
# Pre-issued service account token for ai-sdlc (internal, skips browser flow)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value in ai-sdlc-assistant/config/mcp_clients.yaml headers.Authorization
OAUTH_SERVICE_TOKEN=placeholder
# ── Redis (OAuth token store) ──────────────────────────────────────────────
# Docker: redis://redis:6379  (overridden in docker-compose.yml environment:)
# Local:  redis://localhost:6381
REDIS_URL=redis://localhost:6381

# ── Jira ──────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_TOKEN=placeholder
JIRA_PROJECT_KEY=SDLC

# ── Confluence (same Atlassian token works) ───────────────────────────
CONFLUENCE_SPACE_KEY=SDLC

# ── GitHub ────────────────────────────────────────────────────────────
GITHUB_TOKEN=placeholder
GITHUB_REPO=your-org/your-repo

# ── Slack ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=placeholder
# Set true to use mock Slack data without a real token
SLACK_USE_MOCK=false

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
