# ─────────────────────
#  .gitignore
# ─────────────────────

# Environment — NEVER commit API keys
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# Data (Qdrant + Redis storage — large binary files)
data/qdrant_storage/
data/redis_data/

# Chainlit runtime
.chainlit/
chainlit.md

# Streamlit runtime
.streamlit/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Model cache (sentence-transformers downloads here)
.cache/
