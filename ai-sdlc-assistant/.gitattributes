# .gitattributes
# Normalize line endings on commit so all files are LF in the repo.
# This prevents CRLF issues when data files are read inside Linux Docker containers
# or on CI/CD servers (GitHub Actions, GitLab CI etc.).
#
# How it works:
#   - On commit (Windows): CRLF → LF in the repo
#   - On checkout (Windows): LF → CRLF locally (Windows tools work fine)
#   - On checkout (Mac/Linux): LF stays LF

* text=auto eol=lf

# Explicitly LF — code and config files
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.env   text eol=lf
*.html  text eol=lf
*.ts    text eol=lf
*.css   text eol=lf

# Binary — never mess with these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
