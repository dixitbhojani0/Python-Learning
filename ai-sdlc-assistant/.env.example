# ─────────────────────────────────────────────────────────────────────
#  AI SDLC Assistant — Environment Variables
#  Copy this file to .env and fill in your actual keys
#  NEVER commit .env to git — it's in .gitignore
# ─────────────────────────────────────────────────────────────────────

# ── LLM Provider: Groq (free tier at https://console.groq.com)
GROQ_API_KEY=gsk_placeholder_replace_with_your_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM Provider: Gemini (free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=placeholder_replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash
# 2.0-flash / 2.0-flash-lite are SHUT DOWN — don't use

# ── LangSmith Observability (free tier at https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls_placeholder_replace_with_your_key
LANGCHAIN_PROJECT=ai-sdlc-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Vector Database — Qdrant (runs in Docker, no key needed for local)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sdlc_knowledge

# ── Cache — Redis (runs in Docker, no key needed for local)
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600

# ── Jira / Confluence credentials
# Used ONLY by the admin Confluence ingestion route (/admin/ingest/confluence).
# All other Jira/GitHub/Slack calls go through sdlc-mcp-server — set those in sdlc-mcp-server/.env
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_TOKEN=placeholder_replace_with_your_jira_token
JIRA_PROJECT_KEY=SDLC
CONFLUENCE_SPACE_KEY=SDLC

# ── Application Settings
APP_SECRET_KEY=change_this_to_a_random_secret_string_in_production
APP_ENV=development         # development | production
LOG_LEVEL=INFO

# ── JWT Auth (production only)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Set APP_ENV=production to activate JWT validation (Authorization: Bearer <jwt>)
# Leave as "placeholder" to keep demo token auth (x-token header)
JWT_SECRET_KEY=placeholder

# ── Session / Conversation store
# Leave empty for SQLite (demo). Set for PostgreSQL (production).
# Example: postgresql+asyncpg://sdlc_user:password@localhost:5432/sdlc_db
DATABASE_URL=

# ── HITL
HITL_TTL_SECONDS=86400     # 24 hours — pending approvals expire after this

# ── Demo Users (role-based auth — development only, ignored when JWT is active)
DEMO_TOKEN_DEVELOPER=dev_token_alice
DEMO_TOKEN_MANAGER=manager_token_bob
DEMO_TOKEN_STAKEHOLDER=stakeholder_token_client

# ── Default Project for Demo
DEFAULT_PROJECT=SDLC

# ── MCP Server — OAuth 2.1 service account
# Same value as OAUTH_SERVICE_SECRET in sdlc-mcp-server/.env.
# Client POSTs this to /oauth/token/service → gets a 1hr rotating token automatically.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MCP_SERVICE_SECRET=placeholder
# URL of the sdlc-mcp-server (start it from ../sdlc-mcp-server first)
# Running locally (no Docker):    http://127.0.0.1:8100/mcp
# Running in Docker Desktop:      http://host.docker.internal:8100/mcp
MCP_SERVER_URL=http://127.0.0.1:8100/mcp

# ── Slack Webhook (inbound @mention events → ticket creation)
# SLACK_SIGNING_SECRET: Slack App → Basic Information → App Credentials → Signing Secret
# SLACK_BOT_TOKEN:      Slack App → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
# Event Subscriptions URL:   https://your-domain/webhooks/slack
# Interactivity URL:         https://your-domain/webhooks/slack-action
# Required bot scopes:       app_mentions:read, chat:write, im:write
SLACK_SIGNING_SECRET=placeholder_replace_with_signing_secret
SLACK_BOT_TOKEN=xoxb-placeholder_replace_with_bot_token
